generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  clientCode String    @id
  name       String
  legalName  String?
  industry   String?
  projects   Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model Staff {
  staffId             String  @id
  fullName            String
  firstName           String
  role                String
  roleData            Role?   @relation("PrimaryRole", fields: [role], references: [code])
  level               Int     @default(1)
  costPerHour         Float
  standardHoursPerDay Float   @default(8)
  telegramId          String? @unique
  email               String  @unique @default("")
  recoveryEmail       String?
  password            String  @default("")
  requirePasswordChange Boolean @default(true)
  tokenVersion        Int     @default(1)
  team                String  @default("Creative")
  isActive            Boolean @default(true)

  projectsLed      Project[]            @relation("CreativeLead")
  tasksAssigned    TaskAssignee[]
  leaves           StaffLeaveLog[]
  timesheetsLogged Timesheet[]          @relation("TimesheetOwner")
  timesheetsApprvd Timesheet[]          @relation("TimesheetApprover")
  pnlTransactions  PnlTransaction[]
  leaveApprovals   StaffLeaveLog[]      @relation("LeaveApprover")
  permissions      StaffPermission[]
  auditLogs        AuditLog[]           @relation("AuditPerformedBy")
  secondaryRoles   StaffSecondaryRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  projectCode String @id
  clientCode  String
  client      Client @relation(fields: [clientCode], references: [clientCode])

  creativeLeadId String
  creativeLead   Staff  @relation("CreativeLead", fields: [creativeLeadId], references: [staffId])

  name      String
  status    String
  startDate DateTime
  endDate   DateTime?
  note      String?

  tasks           Task[]
  pnlTransactions PnlTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  version   Int       @default(1)
}

model StaffLeaveLog {
  logId     String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [staffId])
  leaveDate DateTime
  duration  Float
  session   String
  status    String

  approvedById String?
  approvedBy   Staff?  @relation("LeaveApprover", fields: [approvedById], references: [staffId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  taskId       String  @id @default(uuid())
  parentTaskId String?
  parentTask   Task?   @relation("SubTasks", fields: [parentTaskId], references: [taskId])
  subTasks     Task[]  @relation("SubTasks")

  projectCode String
  project     Project @relation(fields: [projectCode], references: [projectCode])

  name        String
  description String?
  startDate   DateTime
  deadline    DateTime
  status      String
  completedAt DateTime?

  assignees  TaskAssignee[]
  timesheets Timesheet[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model TaskAssignee {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [staffId], onDelete: Cascade)

  isDone      Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([taskId, staffId])
}

model Timesheet {
  logId  String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  staffId String
  staff   Staff  @relation("TimesheetOwner", fields: [staffId], references: [staffId])

  hoursLogged Float
  logDate     DateTime
  logSource   String

  approvalStatus String
  approvedById   String?
  approvedBy     Staff?  @relation("TimesheetApprover", fields: [approvedById], references: [staffId])

  historicalCostPerHour Float?
  pnlTransaction        PnlTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  vendorCode      String           @id
  name            String
  service         String?
  pnlTransactions PnlTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PnlTransaction {
  transactionId String  @id @default(uuid())
  projectCode   String
  project       Project @relation(fields: [projectCode], references: [projectCode], onDelete: Cascade)

  referenceId String?
  category    String

  vendorCode String?
  vendor     Vendor? @relation(fields: [vendorCode], references: [vendorCode])

  staffId     String?
  staff       Staff?     @relation(fields: [staffId], references: [staffId])
  timesheetId String?    @unique
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [logId], onDelete: Cascade)

  amount          Float
  transactionDate DateTime
  loggedBy        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyHoliday {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------
// AUTHORIZATION & SECURITY MODELS
// ----------------------------------------

model Permission {
  code     String @id
  name     String
  category String

  rolePermissions  RolePermission[]
  staffPermissions StaffPermission[]
}

model Role {
  code        String  @id
  name        String
  description String?

  staff          Staff[]              @relation("PrimaryRole")
  secondaryStaff StaffSecondaryRole[]
  permissions    RolePermission[]
}

model RolePermission {
  roleCode       String
  permissionCode String

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
}

model StaffPermission {
  id             String  @id @default(uuid())
  staffId        String
  permissionCode String
  isGranted      Boolean

  staff      Staff      @relation(fields: [staffId], references: [staffId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, permissionCode])
}

model StaffSecondaryRole {
  staffId  String
  roleCode String

  staff Staff @relation(fields: [staffId], references: [staffId], onDelete: Cascade)
  role  Role  @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([staffId, roleCode])
}

model AuditLog {
  logId  String @id @default(uuid())
  action String

  performedById String
  performedBy   Staff  @relation("AuditPerformedBy", fields: [performedById], references: [staffId])

  impersonatedId String?
  targetStaffId  String?

  details   String
  createdAt DateTime @default(now())
}
